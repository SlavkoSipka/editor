# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Get from https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=your_freesound_api_key

# Storage mode for sound files:
#   local — full library on disk (dev machines, baked images)        [default]
#   r2    — sounds fetched on-demand from R2 into a small LRU cache
#           (set on Railway Hobby where the 5 GB volume can't hold the library)
# STORAGE_MODE=local
# SOUND_CACHE_MAX_MB=1500

# Optional — Cloudflare R2 (Railway pulls library + embeddings on first boot)
# R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_SYNC_FORCE=0
